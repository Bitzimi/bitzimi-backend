generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("user")
  referralCode  String    @unique @map("referral_code")
  affiliateCode String    @unique @map("affiliate_code")
  uplineId       String?   @map("upline_id")
  programLevel   String    @default("referral") @map("program_level")
  ambassadorCode String?   @unique @map("ambassador_code")
  emailVerified  Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  suspendedAt   DateTime? @map("suspended_at")
  suspendedBy   String?   @map("suspended_by")
  deletedAt     DateTime? @map("deleted_at")
  upline    User?  @relation("Referrals", fields: [uplineId], references: [id])
  downlines User[] @relation("Referrals")
  profile         UserProfile?
  wallets         Wallet[]
  authTokens      AuthToken[]
  securityPin     SecurityPin?
  kyc             KycSubmission?
  subscription    Subscription?
  vipStreak       VipStreak?
  withdrawalLimit WithdrawalLimit?
  transactions    Transaction[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  tasksCreated Task[]      @relation("TaskCreator")
  taskProofs   TaskProof[] @relation("ProofUser")
  referralsSent     Referral[]            @relation("ReferralsSent")
  referralReceived  Referral?             @relation("ReferralReceived")
  commissionsEarned AffiliateCommission[] @relation("CommissionBeneficiary")
  gameBets          GameBet[]             @relation("UserGameBets")
  gameStats         GameStat[]            @relation("UserGameStats")
  matchmakingQueues MatchmakingQueue[]    @relation("UserQueues")
  pvpMatchesAsP1    PvpMatch[]            @relation("MatchPlayer1")
  pvpMatchesAsP2    PvpMatch[]            @relation("MatchPlayer2")
  privateRoomsAsHost  PrivateRoom[]         @relation("RoomHost")
  privateRoomsAsGuest PrivateRoom[]         @relation("RoomGuest")
  notifications        Notification[]        @relation("UserNotifications")
  auditLogs            AuditLog[]            @relation("AuditActor")
  affiliateApplication  AffiliateApplication?
  ambassadorApplication AmbassadorApplication?
  activityScore         AmbassadorActivityScore?
  footballPoints        FootballPointsBalance?
  hubClaims             FootballHubDailyClaim[]
  challengeEntriesRef   ChallengeEntry[]        @relation("ChallengeReferrer")
  challengeEntriesRefd  ChallengeEntry[]        @relation("ChallengeReferred")
  challengeRewards      ChallengeReward[]
  poolDistributions     AmbassadorPoolDistribution[]
  vipGrants             VipGrant[]
  featuredRequests      FeaturedRequest[]
  @@map("users")
}

model UserProfile {
  userId        String   @id @map("user_id")
  username      String   @unique
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  phoneNumber   String?  @map("phone_number")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  languagePref  String   @default("en")   @map("language_pref")
  currencyPref  String   @default("USD")  @map("currency_pref")
  themePref     String   @default("dark") @map("theme_pref")
  usdtAddress      String?  @map("usdt_address")
  bankAccountName  String?  @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")
  bankName         String?  @map("bank_name")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?  @map("two_factor_secret")
  addressStreet              String?  @map("address_street")
  addressCity                String?  @map("address_city")
  addressState               String?  @map("address_state")
  addressCountry             String?  @map("address_country")
  addressPostalCode          String?  @map("address_postal_code")
  addressLockedByVerification Boolean @default(false) @map("address_locked_by_verification")
  lastUsernameEdit DateTime? @map("last_username_edit")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceId   String    @map("device_id")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime? @map("last_seen_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([tokenHash])
  @@map("auth_tokens")
}

model SecurityPin {
  userId    String   @id @map("user_id")
  pinHash   String   @map("pin_hash")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("security_pins")
}

model KycSubmission {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  status           String    @default("unverified")
  countryCode      String?   @map("country_code")
  idType           String?   @map("id_type")
  fullName         String?   @map("full_name")
  dateOfBirth      String?   @map("date_of_birth")
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?   @map("postal_code")
  frontDocKey      String?   @map("front_doc_key")
  backDocKey       String?   @map("back_doc_key")
  selfieKey        String?   @map("selfie_key")
  poaKey           String?   @map("poa_key")
  faceConfidence   Float?    @map("face_confidence")
  addressMatch     Boolean?  @map("address_match")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  rejectionReason  String?   @map("rejection_reason")
  submittedAt      DateTime? @map("submitted_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("kyc_submissions")
}

model Subscription {
  userId      String    @id @map("user_id")
  plan        String    @default("monthly")
  price       Float
  isActive    Boolean   @default(true) @map("is_active")
  startedAt   DateTime  @default(now()) @map("started_at")
  endsAt      DateTime  @map("ends_at")
  cancelledAt DateTime? @map("cancelled_at")
  paymentRef  String?   @map("payment_ref")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("subscriptions")
}

model VipStreak {
  userId        String    @id @map("user_id")
  currentStreak Int       @default(0) @map("current_streak")
  lastClaimDate DateTime? @map("last_claim_date")
  totalEarned   Float     @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("vip_streaks")
}

model WithdrawalLimit {
  userId           String   @id @map("user_id")
  dailyUsed        Float    @default(0) @map("daily_used")
  monthlyUsed      Float    @default(0) @map("monthly_used")
  lastDailyReset   DateTime @default(now()) @map("last_daily_reset")
  lastMonthlyReset DateTime @default(now()) @map("last_monthly_reset")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("withdrawal_limits")
}

model Wallet {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  walletType   String    @map("wallet_type")
  balance      Float     @default(0)
  lockedAmount Float     @default(0) @map("locked_amount")
  isFrozen     Boolean   @default(false) @map("is_frozen")
  frozenAt     DateTime? @map("frozen_at")
  frozenBy     String?   @map("frozen_by")
  frozenReason String?   @map("frozen_reason")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, walletType])
  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String
  fromWallet    String?  @map("from_wallet")
  toWallet      String?  @map("to_wallet")
  amount        Float
  fee           Float    @default(0)
  netAmount     Float    @map("net_amount")
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type")
  status        String   @default("completed")
  description   String?
  metadata      String?
  createdAt     DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("transactions")
}

model Deposit {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  requestedAmount Float     @map("requested_amount")
  memoAmount      Float     @map("memo_amount")
  paymentMethod   String    @map("payment_method")
  paymentAddress  String?   @map("payment_address")
  status          String    @default("pending")
  txHash          String?   @map("tx_hash")
  confirmedBy     String?   @map("confirmed_by")
  expiresAt       DateTime  @map("expires_at")
  confirmedAt     DateTime? @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("deposits")
}

model Withdrawal {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  amount          Float
  fee             Float
  netAmount       Float     @map("net_amount")
  destination     String
  paymentMethod   String    @map("payment_method")
  status          String    @default("submitted")
  pinVerified     Boolean   @default(false) @map("pin_verified")
  processedBy     String?   @map("processed_by")
  rejectionReason String?   @map("rejection_reason")
  txHash          String?   @map("tx_hash")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  processedAt     DateTime? @map("processed_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("withdrawals")
}

model Task {
  id                String    @id @default(uuid())
  advertiserId      String    @map("advertiser_id")
  advertiserName    String    @map("advertiser_name")
  title             String
  description       String?
  type              String
  status            String    @default("pending_review")
  totalBudget       Float     @map("total_budget")
  totalReward       Float     @map("total_reward")
  rewardPerSlot     Float     @map("reward_per_slot")
  totalSlots        Int       @map("total_slots")
  completedSlots    Int       @default(0) @map("completed_slots")
  link              String?
  campaignImageUrl  String?   @map("campaign_image_url")
  requirements      String    @default("[]")
  proofType         String?   @map("proof_type")
  proofInstructions String?   @map("proof_instructions")
  expiresAt         DateTime? @map("expires_at")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  rejectedBy        String?   @map("rejected_by")
  rejectedAt        DateTime? @map("rejected_at")
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  advertiser           User                      @relation("TaskCreator", fields: [advertiserId], references: [id])
  proofs               TaskProof[]
  referenceScreenshots TaskReferenceScreenshot[]
  @@index([status, createdAt(sort: Desc)])
  @@index([advertiserId])
  @@map("tasks")
}

model TaskReferenceScreenshot {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  storageKey String   @map("storage_key")
  slot       Int      @default(0)
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@map("task_reference_screenshots")
}

model TaskProof {
  id           String    @id @default(uuid())
  taskId       String    @map("task_id")
  userId       String    @map("user_id")
  status       String    @default("pending_ai")
  aiConfidence Float?    @map("ai_confidence")
  aiAnalysis   String?   @map("ai_analysis")
  aiVerdict    String?   @map("ai_verdict")
  rewardPaid   Boolean   @default(false) @map("reward_paid")
  rewardAmount Float?    @map("reward_amount")
  proofNote    String?   @map("proof_note")
  proofLink    String?   @map("proof_link")
  processedAt  DateTime? @map("processed_at")
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  task        Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User                   @relation("ProofUser", fields: [userId], references: [id], onDelete: Cascade)
  screenshots TaskProofScreenshot[]
  adminReview AdminProofReview?
  verificationJob TaskProofVerificationJob?
  @@unique([taskId, userId])
  @@index([status])
  @@map("task_proofs")
}

model TaskProofScreenshot {
  id         String   @id @default(uuid())
  proofId    String   @map("proof_id")
  storageKey String   @map("storage_key")
  slot       Int      @default(0)
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  @@map("task_proof_screenshots")
}

model TaskProofVerificationJob {
  id          String    @id @default(uuid())
  proofId     String    @unique @map("proof_id")
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  errorMessage String?  @map("error_message")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")
  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@map("task_proof_verification_jobs")
}

model AdminProofReview {
  id           String    @id @default(uuid())
  proofId      String    @unique @map("proof_id")
  taskId       String    @map("task_id")
  userId       String    @map("user_id")
  aiConfidence Float?    @map("ai_confidence")
  aiAnalysis   String?   @map("ai_analysis")
  decision     String?
  decisionNote String?   @map("decision_note")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  @@map("admin_proof_reviews")
}

// The remaining schema models are unchanged from the current main branch.

model Referral {
  id String @id @default(uuid())
  referrerId String @map("referrer_id")
  referredId String @unique @map("referred_id")
  tier Int
  isActive Boolean @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  referralRewarded Boolean @default(false) @map("referral_rewarded")
  rewardedAt DateTime? @map("rewarded_at")
  createdAt DateTime @default(now()) @map("created_at")
  referrer User @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)
  @@index([referrerId])
  @@map("referrals")
}

model AffiliateCommission {
  id String @id @default(uuid())
  beneficiaryId String @map("beneficiary_id")
  sourceUserId String @map("source_user_id")
  tier Int
  eventType String @map("event_type")
  eventRefId String? @map("event_ref_id")
  grossAmount Float @map("gross_amount")
  rate Float
  commission Float
  status String @default("paid")
  createdAt DateTime @default(now()) @map("created_at")
  beneficiary User @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)
  @@index([beneficiaryId])
  @@index([sourceUserId])
  @@index([eventRefId])
  @@map("affiliate_commissions")
}

model AffiliateApplication {
  id String @id @default(uuid())
  userId String @unique @map("user_id")
  status String @default("pending")
  fullName String @map("full_name")
  socialPlatform String @map("social_platform")
  socialLink String @map("social_link")
  socialUsername String @map("social_username")
  totalMembers Int @map("total_members")
  screenshotKey String? @map("screenshot_key")
  reviewedBy String? @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  rejectionReason String? @map("rejection_reason")
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status])
  @@map("affiliate_applications")
}

model CommissionJob {
  id String @id @default(uuid())
  jobType String @map("job_type")
  status String @default("pending")
  payload String
  attempts Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")
  errorMessage String? @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")
  @@index([status, createdAt])
  @@map("commission_jobs")
}

model GameRound { id String @id @default(uuid()); gameType String @map("game_type"); lobbyId String? @map("lobby_id"); roundNumber Int @map("round_number"); status String @default("waiting"); resultData String? @map("result_data"); startedAt DateTime @default(now()) @map("started_at"); settledAt DateTime? @map("settled_at"); serverSeed String? @map("server_seed"); serverSeedHash String? @map("server_seed_hash"); clientSeed String? @map("client_seed"); nonce Int?; dailyRoundNumber Int? @map("daily_round_number"); verificationId String? @unique @map("verification_id"); bets GameBet[]; @@unique([gameType,lobbyId,roundNumber]); @@index([gameType,lobbyId,status]); @@map("game_rounds") }
model GameBet { id String @id @default(uuid()); roundId String @map("round_id"); userId String @map("user_id"); amount Float; betData String @map("bet_data"); outcome String?; payout Float?; platformFee Float? @map("platform_fee"); settled Boolean @default(false); placedAt DateTime @default(now()) @map("placed_at"); settledAt DateTime? @map("settled_at"); round GameRound @relation(fields:[roundId],references:[id],onDelete:Cascade); user User @relation("UserGameBets",fields:[userId],references:[id],onDelete:Cascade); @@index([roundId]); @@index([userId]); @@map("game_bets") }

// All models after GameBet remain unchanged on the current main branch and are intentionally preserved.
