// ─────────────────────────────────────────────────────────────────────────────
// Phase 22 — Auction Marketplace
// ─────────────────────────────────────────────────────────────────────────────

/// Core auction entity.
/// Two-timer design:
///   Timer 1 → startsAt: countdown until auction goes LIVE (upcoming → live)
///   Timer 2 → endsAt:   auction duration, set when launched (live → ended)
/// Fixed bid: every participant pays exactly bidAmount — no higher, no lower.
/// Current leader = most recent valid bidder (Phase 22.3 updates this).
model Auction {
  id                       String    @id @default(uuid())
  title                    String
  description              String?
  /// "cash_reward" | "vip_subscription" | "gift_card" | "software" | "future_item"
  rewardType               String    @map("reward_type")
  /// Custom label for "future_item" type; also used as display override for all types
  rewardName               String?   @map("reward_name")
  /// Approximate USD display value of the reward
  rewardValue              Float     @map("reward_value")
  /// Base64 data URL — same storage pattern as task campaign images
  rewardImageUrl           String?   @map("reward_image_url")
  /// Fixed bid amount — every bid is EXACTLY this amount, no exceptions
  bidAmount                Float     @map("bid_amount")
  /// How many minutes the auction runs once live (used to compute endsAt)
  durationMinutes          Int       @map("duration_minutes")
  /// If remaining time ≤ this many seconds and a bid arrives → extension triggers
  extensionWindowSeconds   Int       @default(60)  @map("extension_window_seconds")
  /// When extension triggers, remaining time resets to this many seconds (default 10 min)
  extensionDurationSeconds Int       @default(600) @map("extension_duration_seconds")
  /// FIRST TIMER target: when the auction goes LIVE from upcoming state
  startsAt                 DateTime  @map("starts_at")
  /// SECOND TIMER target: computed when launched = launch_time + durationMinutes
  endsAt                   DateTime? @map("ends_at")
  /// "draft" | "upcoming" | "live" | "paused" | "ended" | "cancelled"
  status                   String    @default("draft")
  /// "private" (admin only) | "public" (visible to all users)
  visibility               String    @default("private")
  /// userId of the current leader — masked on frontend (Phase 22.3 updates)
  currentLeaderId          String?   @map("current_leader_id")
  /// Accumulated pool — incremented per bid in Phase 22.3
  currentPool              Float     @default(0) @map("current_pool")
  /// Total bid count — incremented per bid in Phase 22.3
  bidCount                 Int       @default(0) @map("bid_count")
  /// Unique participant count — incremented per new participant in Phase 22.3
  participantCount         Int       @default(0) @map("participant_count")
  /// How many times the last-minute extension has fired
  extensionCount           Int       @default(0) @map("extension_count")
  lastExtendedAt           DateTime? @map("last_extended_at")
  lastBidAt                DateTime? @map("last_bid_at")
  createdBy                String    @map("created_by")
  updatedBy                String?   @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt     @map("updated_at")

  bids          AuctionBid[]
  statusHistory AuctionStatusHistory[]
  collection    AuctionCollection?

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([visibility, status])
  @@map("auctions")
}

/// Architecture placeholder for Phase 22.3 live bidding engine.
/// Bid placement, wallet deductions, and pool accumulation are NOT implemented yet.
model AuctionBid {
  id        String   @id @default(uuid())
  auctionId String   @map("auction_id")
  userId    String   @map("user_id")
  /// Always equals auction.bidAmount at time of placement
  amount    Float
  /// Sequential bid number within this auction (1, 2, 3 …)
  bidNumber Int      @map("bid_number")
  /// True only for the most recent bid (current leader); cleared on next bid
  isLeading Boolean  @default(false) @map("is_leading")
  createdAt DateTime @default(now()) @map("created_at")

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([userId])
  @@index([auctionId, bidNumber])
  @@index([auctionId, isLeading])
  @@map("auction_bids")
}

/// Full audit trail of every auction status transition.
model AuctionStatusHistory {
  id         String   @id @default(uuid())
  auctionId  String   @map("auction_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  String   @map("changed_by")
  reason     String?
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@map("auction_status_history")
}

/// User reward collection. Populated when an auction winner is determined (Phase 22.3).
model AuctionCollection {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  /// One winner per auction
  auctionId     String    @unique @map("auction_id")
  /// "pending_claim" | "claimed" | "expired" | "delivered"
  status        String    @default("pending_claim")
  claimedAt     DateTime? @map("claimed_at")
  /// When the claim window closes (7 days from auction end)
  expiresAt     DateTime? @map("expires_at")
  /// Admin-provided delivery info shown after claim (VIP details, gift card code, license key, etc.)
  deliveryNotes String?   @map("delivery_notes")
  /// Structured reward data (JSON): gift card code, license key, VIP grant details, etc.
  rewardData    String?   @map("reward_data")
  /// Replay protection: number of claim attempts made
  claimAttempts Int       @default(0) @map("claim_attempts")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  auction Auction @relation(fields: [auctionId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("auction_collection")
}

// ── Globalisation — Phase 24.2 ────────────────────────────────────────────────

model Language {
  code       String   @id
  name       String
  nativeName String   @map("native_name")
  flag       String?
  direction  String   @default("ltr")
  isDefault  Boolean  @default(false) @map("is_default")
  isEnabled  Boolean  @default(true)  @map("is_enabled")
  sortOrder  Int      @default(0)     @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")
  translations Translation[]
  @@map("languages")
}

model TranslationKey {
  id           String   @id @default(cuid())
  key          String   @unique
  namespace    String   @default("common")
  defaultValue String   @map("default_value")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")
  translations Translation[]
  @@index([namespace])
  @@map("translation_keys")
}

model Translation {
  id              String   @id @default(cuid())
  languageCode    String   @map("language_code")
  key             String
  value           String
  isAutoTranslated Boolean @default(false) @map("is_auto_translated")
  isApproved      Boolean  @default(true)  @map("is_approved")
