// ── Phase 20 — Monthly Referral Challenge ─────────────────────────────────────

model ReferralChallenge {
  id             String   @id @default(uuid())
  title          String
  description    String?
  period         String   @unique               // "2025-01" (YYYY-MM)
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  status         String   @default("upcoming")  // upcoming|active|ended|cancelled
  // Three separate cash pools — each distributed among top-N of that program level
  referralPool   Float    @default(200) @map("referral_pool")    // USD — shared among top N referral-level users
  referralTopN   Int      @default(50)  @map("referral_top_n")   // how many referral users share the pool
  affiliatePool  Float    @default(350) @map("affiliate_pool")   // USD — shared among top N affiliate-level users
  affiliateTopN  Int      @default(10)  @map("affiliate_top_n")
  ambassadorPool Float    @default(400) @map("ambassador_pool")  // USD — shared among top N ambassador-level users
  ambassadorTopN Int      @default(3)   @map("ambassador_top_n")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  entries ChallengeEntry[]
  rewards ChallengeReward[]
  vipGrants VipGrant[]

  @@map("referral_challenges")
}

model ChallengeEntry {
  id          String   @id @default(uuid())
  challengeId String   @map("challenge_id")
  referrerId  String   @map("referrer_id")
  referredId  String   @map("referred_id")
  qualifiedAt DateTime @default(now()) @map("qualified_at")

  challenge ReferralChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  referrer  User              @relation("ChallengeReferrer", fields: [referrerId], references: [id])
  referred  User              @relation("ChallengeReferred", fields: [referredId], references: [id])

  @@unique([challengeId, referredId])
  @@index([challengeId, referrerId])
  @@map("challenge_entries")
}

model ChallengeReward {
  id          String    @id @default(uuid())
  challengeId String    @map("challenge_id")
  userId      String    @map("user_id")
  level       String                          // referral|affiliate|ambassador
  rank        Int                             // rank within that level's pool
  amount      Float
  paid        Boolean   @default(false)
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  challenge ReferralChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([challengeId, level, rank])
  @@index([challengeId, level])
  @@map("challenge_rewards")
}

